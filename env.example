# Server-side owner security. NEVER put these values in src/ or VITE_ variables.
OWNER_PASSWORD="choose-a-long-unique-password"
SESSION_SECRET="generate-a-long-random-secret"

# Optional but recommended for persistent publishing through GitHub.
# Use a fine-grained GitHub token with Contents: Read and write access
# ONLY to this portfolio repository.
GITHUB_TOKEN="github_pat_..."
GITHUB_OWNER="your-github-username"
GITHUB_REPO="your-portfolio-repository"
GITHUB_BRANCH="main"
GITHUB_PROJECTS_PATH="storage/custom-projects.json"

# Optional local development settings
PORT="3000"
NODE_ENV="development"
